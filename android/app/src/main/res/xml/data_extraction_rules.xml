<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml: controls both cloud backup
     (Google account) and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/"/>
        <include domain="sharedpref" path="."/>
        <exclude domain="root" path="app_flutter/leadflow.sqlite-journal"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/"/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
